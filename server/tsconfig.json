{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDirs": [
      "./src",
      "./generated"
    ],
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "prisma7.config.ts",
    "**/*.spec.ts",
    "generated/**/*"
  ]
}